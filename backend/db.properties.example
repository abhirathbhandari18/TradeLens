# TradeLens Database & Market API Configuration Template
# Copy this file to 'db.properties' and set your Aiven MySQL & API credentials.

db.url=jdbc:mysql://YOUR_AIVEN_HOST:10729/defaultdb?sslMode=REQUIRED&serverTimezone=UTC
db.user=avnadmin
db.password=your_aiven_password_here

api.provider=tapetide
api.baseUrl=https://api.tapetide.com/v1
api.token=your_tapetide_token_here
